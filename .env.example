# gaggiclanker configuration.
#
#   cp .env.example .env
#
# Everything here is optional except GAGGIMATE_HOST, which is what connects the
# app to your machine. Values set here are the baseline; anything you later
# change in the Settings page is stored in the database and wins over this file,
# so a key you edit in the UI does not quietly revert on the next restart.
#
# Docker Compose reads this file twice: once for ${VAR} substitution inside
# compose.yml, and once as the container's env_file. That is why the variable
# names here match the ones the app reads.


# --- The machine ------------------------------------------------------------

# Hostname or IP of the GaggiMate display board, with no scheme. The port is
# optional: the firmware serves HTTP and the WebSocket on port 80, so a bare
# host is the normal form, but `host:port` is accepted too — which is what you
# need for the firmware simulator (127.0.0.1:8080) or the fake device
# (127.0.0.1:8090).
#
# Prefer a fixed IP or a DHCP reservation. mDNS (gaggimate.local) does not
# resolve from inside a Docker bridge network, and the firmware disables mDNS
# altogether when HomeKit is enabled — so a name that works in your browser can
# still fail in the container.
#
# Leave it empty to run the app as an archive browser with no machine attached:
# nothing syncs, and everything already imported still works.
GAGGIMATE_HOST=192.168.1.50

# WebSocket scheme: ws or wss. The firmware serves plain HTTP on port 80 and
# never terminates TLS, so leave this as ws unless you have put a reverse proxy
# in front of the machine.
GAGGIMATE_PROTOCOL=ws

# How long to wait, in seconds, for one device request — a WebSocket response
# frame or an HTTP body. The machine's own browser UI waits 30 s; shorter is
# better here because a stuck request holds one of only two HTTP slots, and the
# firmware has about 300 KB of heap to serve them from.
GAGGIMATE_TIMEOUT_S=15

# Hold the WebSocket, so the header pill can say whether the machine is online
# and so a pull, a profile push or a notes write-back has somewhere to go. Set
# to false to look at an existing archive without touching the machine at all.
#
# Nothing is mirrored on its own either way. Shots, profiles and notes move when
# a pull is asked for — the button on the shots page, or POST /api/sync/run.
#
# The firmware allows three WebSocket clients in total, and the GaggiMate's own
# browser UI is one of them; gaggiclanker holds exactly one.
GAGGICLANKER_DEVICE_SYNC_ENABLED=true


# --- Writing to the machine -------------------------------------------------
#
# Off, and off is the interesting state. With this false the device client's
# five write methods refuse before anything reaches the wire, and every refusal
# is still recorded in the `device_writes` audit table. Turn it on and
# gaggiclanker may: save a NEW profile (never overwrite an existing one), delete
# a profile it created itself and whose label carries the " [AI]" suffix, select
# one, and star or unstar one. It never writes device settings — POST
# /api/settings on the firmware clears every boolean key the body omits, which
# is how a partial write turns off HomeKit, boiler fill and the momentary
# buttons — and it never writes shot history.
#
# What can go wrong if this is on and something is wrong: a profile with zero
# phases crashes brew start on the display, and recovering that means a reflash
# plus a filesystem erase. Four layers stand in the way (strict schema, the
# safety policy below, a save-then-load round trip, a simulator gate in CI), and
# this switch is the fifth.
GAGGICLANKER_DEVICE_WRITES_ENABLED=false

# Device storage cleanup. The machine holds a few megabytes of shot
# history and deletes its own oldest shot whenever free space drops below
# 500 KB, archived or not. These settings only change *when* a shot leaves the
# machine: nothing is ever deleted unless this box already holds its raw bytes,
# unquarantined and the length its header implies.
#
#   off          delete nothing (the default)
#   keep_newest  keep GAGGICLANKER_DEVICE_CLEANUP_KEEP_NEWEST shots on the machine
#   free_space   delete oldest-first until GAGGICLANKER_DEVICE_CLEANUP_MIN_FREE_KB is free
GAGGICLANKER_DEVICE_CLEANUP_MODE=off
GAGGICLANKER_DEVICE_CLEANUP_KEEP_NEWEST=50
GAGGICLANKER_DEVICE_CLEANUP_MIN_FREE_KB=2048
# Run the policy after every successful index read rather than only on the
# button. Needs GAGGICLANKER_DEVICE_WRITES_ENABLED as well.
GAGGICLANKER_DEVICE_CLEANUP_AUTO=false

# Write judgements back to the machine's own notes card, so the
# touchscreen shows what you thought of the cup. Off by default, gated by
# GAGGICLANKER_DEVICE_WRITES_ENABLED too, and the device copy is only
# overwritten when the verdict here is newer than the note on the machine.
GAGGICLANKER_NOTES_WRITEBACK_ENABLED=false
# Which fields are mirrored. Allowed: rating, balance, doseIn, doseOut,
# grindSetting, notes. Anything left out keeps whatever the machine has.
GAGGICLANKER_NOTES_WRITEBACK_FIELDS=rating,balance,doseIn,doseOut,grindSetting

# The safety policy: bounds narrower than the firmware's own parser, which a
# draft is clamped to and then re-validated against. The firmware accepts
# temperatures up to 150 C and phases up to 300 s; neither is a number anybody
# should reach by accident. Every clamp is reported beside the approval button,
# and anything a clamp cannot fix is refused rather than quietly rewritten.
GAGGICLANKER_PROFILE_POLICY_TEMP_MIN_C=60
GAGGICLANKER_PROFILE_POLICY_TEMP_MAX_C=100
GAGGICLANKER_PROFILE_POLICY_PRESSURE_MAX_BAR=12
GAGGICLANKER_PROFILE_POLICY_FLOW_MAX_ML_S=10
GAGGICLANKER_PROFILE_POLICY_PHASE_MIN_S=0.5
GAGGICLANKER_PROFILE_POLICY_PHASE_MAX_S=120

# Refused rather than trimmed: truncating a profile would change what it brews
# while claiming to have made it safe.
GAGGICLANKER_PROFILE_POLICY_MAX_PHASES=10


# --- Storage ----------------------------------------------------------------

# Where the SQLite database and the backups/ directory live — the one path that
# must survive a container recreate. Everything is in that one file (shots, the
# raw .slog bytes, profiles, judgements, analyses), so backing it up is copying
# a file.
#
# Left commented on purpose. The image already sets DATA_DIR=/app/data, and
# uncommenting it here would also point a local `uv run` at /app/data, which
# does not exist outside the container. Set it only if you are running the app
# directly and want the data somewhere other than ./data.
# DATA_DIR=./data

# Port published on the host by compose.yml; the container always listens on
# 8000 internally, so this changes only the address you type in the browser.
HOST_PORT=8000

# Address and port the app binds to when you run it yourself (`uv run
# gaggiclanker`), outside Compose.
#
# Both are commented out because Compose passes this whole file into the
# container, where it would override the image's own values: HOST=127.0.0.1
# would make the app listen on the container's loopback only, and the published
# port would connect to nothing. PORT here is the *container-internal* port and
# is not what Compose publishes — that is HOST_PORT above. If you do change
# PORT, change the right-hand side of the port mapping in compose.yml to match.
# HOST=127.0.0.1
# PORT=8000

# The uid/gid the container runs as. Set these to your own (`id -u`, `id -g`)
# if ./data ends up owned by a user you cannot write to.
APP_UID=1000
APP_GID=1000


# --- Logging ----------------------------------------------------------------

# debug, info, warning or error. debug logs every device frame, which is a lot
# at 2 Hz telemetry — useful when a sync misbehaves, noisy otherwise.
LOG_LEVEL=info

# One JSON object per line (right for a container log driver) or human-readable
# console output (right when you are reading it yourself in a terminal).
LOG_JSON=true


# --- LLM --------------------------------------------------------------------

# Which provider answers a call:
#
#   claude_code        the Claude Code CLI, spending a Claude subscription
#   anthropic          the Anthropic API, with an API key
#   openrouter         OpenRouter
#   openai             OpenAI
#   ollama             a local Ollama
#   lmstudio           a local LM Studio
#   openai_compatible  any other gateway that speaks /v1/chat/completions
#
# claude_code is the default because it needs no API key of its own — if you
# already pay for Claude, it is the cheapest thing to get working.
GAGGICLANKER_LLM_PROVIDER=claude_code

# Endpoint for the self-hosted and generic presets only (ollama, lmstudio,
# openai_compatible). Empty uses the preset's own URL.
#   Ollama       http://host.docker.internal:11434/v1
#   LM Studio    http://host.docker.internal:1234/v1
#
# Deliberately ignored for the hosted providers: redirecting OpenRouter or
# OpenAI while still sending their key is how an API key ends up on somebody
# else's server.
GAGGICLANKER_LLM_BASE_URL=

# API key for the openai-compatible provider selected above. It belongs to that
# provider alone and is never sent to another one. Also settable from the
# Settings page, which is the better place for it: the API only ever returns a
# four-character hint, so it never sits in a browser tab in full.
GAGGICLANKER_LLM_API_KEY=

# API key for the `anthropic` provider. Separate from the one above so that
# switching provider cannot send one service's key to another. It is never
# passed to the claude_code CLI — an ambient API key there would silently
# shadow the subscription and start billing per token for work you have
# already paid for.
ANTHROPIC_API_KEY=

# Subscription token for the `claude_code` provider. Mint it with
#   claude setup-token
#
# An interactive `claude login` is NOT enough. Every call runs the CLI with a
# scratch HOME and a scratch working directory, so that no ambient CLAUDE.md or
# session state can reach the model — which hides ~/.claude as well. A box that
# is logged in but has no token here gets "Not logged in - please run /login"
# back from an otherwise perfect call.
CLAUDE_CODE_OAUTH_TOKEN=

# The Claude Code binary. A bare name is looked up on PATH; give an absolute
# path when the CLI is installed somewhere the app's PATH does not reach.
CLAUDE_CODE_BIN=claude

# How hard claude_code thinks: low, medium, high, xhigh or max. Empty lets the
# CLI decide. An unrecognised value is dropped rather than passed through.
CLAUDE_CODE_EFFORT=

# How long one attempt may take before it is abandoned, in seconds. Five
# minutes: a reasoning model working through a shot's diagnostics genuinely
# takes minutes, and a deadline shorter than the work turns every analysis into
# a timeout.
GAGGICLANKER_LLM_TIMEOUT_S=300

# How many times the whole process retries a rate limit before it latches and
# stops calling the provider at all. Shared by every call rather than per call:
# when the account is throttled the next shot will be refused too, so failing
# sixty of them slowly is worse than stopping once and saying so. Clear the
# latch from the Settings page. 0 stops at the first 429.
GAGGICLANKER_LLM_RATE_LIMIT_RETRIES=2

# Keep the rendered prompt and the raw reply on each row of the call ledger,
# capped at 200 KB each. On by default because prompts are editable, so without
# the text an analysis stored today cannot be explained after the prompt that
# produced it has changed.
GAGGICLANKER_LLM_STORE_CALL_TEXT=true

# How many estimated tokens of knowledge-base prose one analysis may be given.
# The retrieved excerpts are supporting context — the rule tier is what is
# authoritative — so the default buys two or three passages and leaves the shot,
# its trajectory and the rules dominating the prompt. 0 turns retrieval off.
GAGGICLANKER_ANALYSIS_CHUNK_TOKEN_BUDGET=1500

# The model each kind of call uses. A purpose with nothing set falls back to
# MODEL_DEFAULT, and an empty MODEL_DEFAULT lets the provider choose — which
# for claude_code means the CLI's own default. Ids are provider-specific:
# `sonnet` or `claude-sonnet-5` for Claude, `anthropic/claude-sonnet-5` for
# OpenRouter, `llama3.1` for Ollama.
GAGGICLANKER_MODEL=
GAGGICLANKER_MODEL_ANALYSIS=
GAGGICLANKER_MODEL_DRAFT=
GAGGICLANKER_MODEL_CHAT=
# The starting-point wizard authors a whole profile in one call, so it wants the
# careful model rather than the fast one.
GAGGICLANKER_MODEL_STARTING_POINT=


# --- The chat and MCP -------------------------------------------------------

# What one chat answer may spend. A round is one model call plus whatever tools
# it asked for; hit either bound and the model is told to answer with what it
# already has. These exist because a model that keeps re-querying is the failure
# mode that spends an afternoon's tokens on one question.
GAGGICLANKER_CHAT_MAX_TOOL_ROUNDS=8
GAGGICLANKER_CHAT_MAX_TOOL_CALLS=20

# Roughly how many tokens of conversation history each turn carries. Oldest
# messages are dropped first; the newest question is always kept.
GAGGICLANKER_CHAT_HISTORY_TOKEN_BUDGET=12000

# Serve the MCP endpoint at /mcp (Streamable HTTP), so any MCP client that can
# send a header gets the same tools the in-app chat has: read and propose, never
# a write to the machine. Off by default on
# purpose: it hands an outside agent the whole archive, and that is a switch you
# throw when you want it rather than one you inherit. Claude Desktop and
# `claude -p` use the stdio entry point (`gaggiclanker mcp`), which needs no
# server and is unaffected by this setting.
GAGGICLANKER_MCP_ENABLED=false


# --- Authentication ---------------------------------------------------------

# Off unless you set a username and a password below. That is the right default
# for a machine only your own LAN can reach: the GaggiMate itself has no auth,
# no TLS and no CORS, so on a home network gaggiclanker is already the strictest
# thing on the wire.
#
# Turn it on if this box is port-forwarded, on a shared flat's network, or
# behind a reverse proxy that the internet can reach. With it on, every route
# under /api needs a bearer token - the live streams and the OpenAPI docs
# included - while /health and the web app itself stay public.
#
# Both of these are also editable from the Settings page, and the switch is
# re-read on every request, so turning auth on there takes effect immediately
# and needs no restart.

# The username. Empty (the default) means auth is off entirely.
AUTH_USER=

# The first password, in plain text. It SEEDS the install: the first boot that
# finds no password stored hashes this one with argon2id, keeps the hash, and
# never writes the plain value anywhere. After that this line is inert - a boot
# that re-applied it would silently undo a password changed in the Settings
# page, at three in the morning, with nothing in the log to explain why.
#
# So: set it once to get in, then change the password in the UI (Settings ->
# Authentication) and leave this line alone. To reset a password you have lost,
# clear the stored one first:
#   docker compose exec gaggiclanker python -c \
#     "import sqlite3;sqlite3.connect('/app/data/gaggiclanker.db').execute(\
#      \"DELETE FROM settings WHERE key='authPasswordHash'\").connection.commit()"
# then restart with AUTH_PASSWORD set to the new one.
AUTH_PASSWORD=

# The argon2id hash instead, if you would rather the plain password never
# appeared in a file or a `docker inspect`. Generate one with:
#
#   docker compose run --rm --entrypoint python gaggiclanker -c \
#     "from argon2 import PasswordHasher; print(PasswordHasher().hash(input()))"
#
# Set either this or AUTH_PASSWORD, not both. A value here that is not an
# argon2 hash does NOT switch auth off - it leaves it on and refuses every
# sign-in, because a broken credential must never be the thing that unlocks the
# door. The settings API refuses to store one at all.
AUTH_PASSWORD_HASH=

# How long a session token stays valid, in seconds. Thirty days by default,
# because this is an appliance whose tab stays open for weeks and signing out is
# a button that revokes the session on the server rather than something the
# expiry has to do.
AUTH_TOKEN_TTL_S=2592000

# The HS256 key that signs session tokens. Leave it empty: one is generated on
# first boot and kept in the database, so sessions survive a restart and a
# restored backup. Set it (32 characters or more) only if you run two processes
# against the same database and want a token issued by one to work on the other.
AUTH_JWT_SECRET=


# --- Development only -------------------------------------------------------

# Origins allowed to call the API cross-origin. Empty in production, where the
# built SPA is served from this same origin. The Vite dev server needs its own
# entry, because it serves the front end from a different port:
#   CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# Directory holding the built SPA. Unset means <repo>/web/dist, which is what a
# source checkout wants; the image sets it explicitly because the package is
# installed into a venv and cannot find the bundle relative to itself.
# WEB_DIST=
