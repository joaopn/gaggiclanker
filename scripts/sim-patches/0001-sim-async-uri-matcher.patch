 using ArRequestHandlerFunction = std::function<void(AsyncWebServerRequest *)>;
+using ArRequestFilterFunction = std::function<bool(AsyncWebServerRequest *)>;
+
+// Minimal stand-in for ESPAsyncWebServer 3.12's AsyncURIMatcher. WebUIPlugin
+// uses exactly one form of it -- AsyncURIMatcher::prefix("/api/history/") for
+// the "Update in progress" filter -- so prefix matching is all this carries.
+class AsyncURIMatcher {
+  public:
+    static AsyncURIMatcher prefix(const char *uri) { return AsyncURIMatcher(uri); }
+    const std::string &uri() const { return _uri; }
+
+  private:
+    explicit AsyncURIMatcher(const char *uri) : _uri(uri) {}
+    std::string _uri;
+};
+
+class AsyncWebServer;
+
+// What on() hands back so that .setFilter() has somewhere to go. It refers to
+// the route by index rather than by pointer: the route vector can reallocate,
+// and a handle that outlived one push_back would be a use-after-free that only
+// showed up under load.
+class AsyncWebHandlerRef {
+  public:
+    AsyncWebHandlerRef(AsyncWebServer *server, size_t index) : _server(server), _index(index) {}
+    AsyncWebHandlerRef &setFilter(ArRequestFilterFunction filter);
+
+  private:
+    AsyncWebServer *_server;
+    size_t _index;
+};
 
